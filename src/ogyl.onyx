package ogyl
use core{*}

// ---- Context ----
#if #defined(js) {
// --- WEB ---

Context :: WebContext
WebContext :: struct {}
#overload
delete :: (self: &WebContext) {}

g_ctx: &WebContext
g_callback: (&WebContext) -> void

create_web_context :: (canvas_id: str, width: ?i32 = .{}, height: ?i32 = .{}) -> Context {
    return .{}
}

WebContext.clear_background_color :: #match {
    (ctx: &#Self, color: Color) -> void {

    },
    (ctx: &#Self, color: [4]i32) -> void {

    }
}

WebContext.start_application_loop :: (ctx: &#Self, callback: (&#Self) -> void) {
    g_ctx = ctx
    g_callback = callback
    js.Global->set("ONYX", js.Onyx)
    js.Global->call("requestAnimationFrame", loop)
    loop :: (_: js.Value, args: [] js.Value) -> js.Value {
        defer js.release_pooled_objects()

        g_callback(g_ctx)

        js.Global->call("requestAnimationFrame", loop)
        return js.Undefined
    }
}

// --- WEB ---
} else {
// --- NATIVE ---

Context :: NativeContext
NativeContext :: struct {}
#overload
delete :: (ctx: &NativeContext) {}

create_native_context :: (window_name: str, width: i32 = 800, height: i32 = 600) -> Context {
    return .{}
}

NativeContext.clear_background_color :: #match {
    (ctx: &#Self, color: Color) -> void {

    },
    (ctx: &#Self, color: [4]i32) -> void {

    }
}

NativeContext.start_application_loop :: (ctx: &#Self, callback: (&#Self, &$T) -> void, usr_ctx: &$T) {
    while true {
        callback(ctx, usr_ctx)
    }
}

// --- NATIVE ---
}

// ---- Context ----

// ---- Shaders ----
Shader :: struct {}
Shader.make :: (vertex_source, fragment_source: str, ctx: &Context) -> #Self {
    return .{}
}
#overload
delete :: (shader: &Shader) {}

// ---- Shaders ----

// ---- Shapes - Triangle ----
Triangle :: struct {
    verticies: [3][3]f32
}
Triangle.make :: (a, b, c: [3]f32) -> #Self {
    return .{.[a, b, c]}
}

// ---- Shapes - Triangle ----

// ---- Color ----
Color :: enum {
    Black
    White
    Yellow
    Green
    // TODO: MOREEEEEEE
}
// ---- Color ----

// --- Helpers ---
LogLevel :: enum {Debug; Info; Error;}
log :: (level: LogLevel, text: str) {
    lvl_txt: str
    switch level {
        case .Debug {
            lvl_txt = "DEBUG"
        }
        case .Info {
            lvl_txt = "INFO "
        }
        case .Error {
            lvl_txt = "ERROR"
        }
    }
    #if #defined(js) {
        js.Global->get("console")->call("log", "[", lvl_txt, "] ", text)
    } else {
        printf("[{}] {}\n", lvl_txt, text)
    }
}
// --- Helpers ---
