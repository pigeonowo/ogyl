#load "../lib/packages"

use core{*}
#if #defined(js){
    use webgl2{wgl :: package, *}
} else {
    use glfw3{glfw :: package, *}
    use opengles{gl :: package, *}
}

// ---- Context ----
#if #defined(js) {
    // --- WEB ---

    Context :: WebContext
    WebContext :: struct {
        gl_ctx: js.Value
    }
    #overload
    delete :: (self: &WebContext) {}

    g_ctx: &WebContext
    g_callback: (&WebContext) -> void

    create_web_context :: (canvas_id: str, width: ?i32 = .{}, height: ?i32 = .{}) -> ?Context {
        log(.Debug, "Setting up canvas...")
        js.setup_default_pool()
        use doc := js.Global->get("document")
        use canvas := doc->call("getElementById", canvas_id)
        canvas->set("width", js.Global->get("innerWidth"))
        canvas->set("height", js.Global->get("innerHeight"))
        gl_ctx := canvas->call("getContext", "webgl2")
        glInit(gl_ctx)
        return .{gl_ctx}
    }

    WebContext.clear_background_color :: #match {
        (ctx: &#Self, color: ColorValue) -> void {

        },
        (ctx: &#Self, color: [4]i32) -> void {

        }
        (ctx: &#Self, color: Color) -> void {
            glClearColor(color.r, color.g, color.b, color.a)
            glClear(GL_COLOR_BUFFER_BIT)
        }
    }

    WebContext.start_application_loop :: (ctx: &#Self, callback: (&#Self) -> void) {
        g_ctx = ctx
        g_callback = callback
        js.Global->set("ONYX", js.Onyx)
        js.Global->call("requestAnimationFrame", loop)
        loop :: (_: js.Value, args: [] js.Value) -> js.Value {
            defer js.release_pooled_objects()

            g_callback(g_ctx)

            js.Global->call("requestAnimationFrame", loop)
            return js.Undefined
        }
    }

    // --- WEB ---
} else {
    // --- NATIVE ---

    Context :: NativeContext
    NativeContext :: struct {
        window: GLFWwindow_p
    }
    #overload
    delete :: (ctx: &NativeContext) {
        // glfwMakeContextCurrent()
        glfwTerminate()
    }

    create_native_context :: (window_name: [&]u8, width: i32 = 800, height: i32 = 600) -> ?Context {
        // GLFW Setup
        log(.Info, "glfw initializing...")
        init_succeeded := glfwInit()
        if init_succeeded {
            log(.Info, "glfwInit succeeded")
        } else {
            log(.Info, "glfwInit NOT succeeded")
        }
        if !init_succeeded do return .None
        window := glfwCreateWindow(width, height, window_name)
        // if window == 0 do return .None
        glfwMakeContextCurrent(window)

        // OpenGL Setup
        glInit(glfwGetLoadProcAddress())
        glViewport(0, 0, width, height)

        log(.Info, "Window created!")

        return Context.{window}
    }

    NativeContext.clear_background_color :: #match {
        (ctx: &#Self, color: [4]i32) -> void {

        },
        (ctx: &#Self, color: Color) -> void {
            glClearColor(color.r, color.g, color.b, color.a)
            glClear(GL_COLOR_BUFFER_BIT)
        }
    }

    NativeContext.start_application_loop :: (ctx: &#Self, callback: (&#Self) -> void) {
        while true {
            callback(ctx)
            glfwSwapBuffers(ctx.window);
            glfwPollEvents();
        }
    }

    // --- NATIVE ---
}

// ---- Context ----

// ---- Shaders ----
#if #defined(js) {
    ShaderID :: GLShader
    Shader :: struct {
        shader: GLProgram
    }
} else {
    ShaderID :: GLuint
    Shader :: struct {
        shader: GLuint
    }
}

Shader.make :: (vertex_source, fragment_source: str, ctx: &Context) -> ?#Self {
    log(.Info, "shader compilation started...")
    vertex_shader   := compile_shader(GL_VERTEX_SHADER, vertex_source)?
    fragment_shader := compile_shader(GL_FRAGMENT_SHADER, fragment_source)?

    program := glCreateProgram()
    glAttachShader(program, vertex_shader)
    glAttachShader(program, fragment_shader)
    glLinkProgram(program)

    #if #defined(js) {
        if glGetProgramParameter(program, GL_LINK_STATUS) == 0 {
            log(.Error, "Failed to link program.")
            js.Global->get("console")->call("log", wgl.glGetProgramInfoLog(program))
            return .None
        }
    } else {
        success: GLuint = 0
        glGetProgramiv(program, GL_LINK_STATUS, &success)
        if success == 0 {
            log(.Error, "Failed to link program.")
            return .None
        }
    }

    log(.Info, "Completed shader compilation!")
    return Shader.{program}
}

#overload
delete :: (shader: &Shader) {}

Shader.use_shader :: (shader: Shader) {
    glUseProgram(shader.shader)
}

compile_shader :: (type: GLenum, source: str) -> ?ShaderID {
    shader := glCreateShader(type)

    #if #defined(js) {
        glShaderSource(shader, source)
    } else {
        source_data := cptr.make(source.data)
        glShaderSource(shader, 1, &source_data, &source.count)
    }
    glCompileShader(shader)

    #if #defined(js) {
        if glGetShaderParameter(shader, GL_COMPILE_STATUS) == 0 {
            log(.Error, "Failed to compile shader.")
            js.Global->get("console")->call("log", glGetShaderInfoLog(shader))
            return .None
        }
    } else {
        success := 0
        glGetShaderiv(shader, GL_COMPILE_STATUS, &success)
        if success == 0 {
            log(.Error, "Failed to compile shader.")
            return .None
        }
    }

    return shader
}
// ---- Shaders ----

// ---- Shapes - Triangle ----
Vec2 :: [2]f32
Color :: [4]f32

Triangle :: struct {
    verticies: [3]Vec2
    color_data: [3]Color
    vao: GLuint
}

Triangle.make :: (a, b, c: Vec2, acolor, bcolor, ccolor: Color) -> #Self {
    t := Triangle.{.[a, b, c], .[acolor, bcolor, ccolor], 0}

    // Create VBO for verticies
    #if #defined(js){
    vertex_buf := glCreateBuffer()
    } else {
    vertex_buf: GLuint
    glGenBuffers(1, &vertex_buf)
    }
    glBindBuffer(GL_ARRAY_BUFFER, vertex_buf)
    #if #defined(js){
    glBufferData(GL_ARRAY_BUFFER, to_byte_array(t.verticies), GL_STATIC_DRAW)
    } else {
    glBufferData(GL_ARRAY_BUFFER, sizeof typeof t.verticies, to_byte_array(t.verticies).data, GL_STATIC_DRAW)
    }

    #if #defined(js){
    color_buf := glCreateBuffer()
    } else {
    color_buf: GLuint
    glGenBuffers(1, &color_buf)
    }
    glBindBuffer(GL_ARRAY_BUFFER, color_buf)
    #if #defined(js){
    glBufferData(GL_ARRAY_BUFFER, to_byte_array(t.color_data), GL_STATIC_DRAW)
    } else {
    glBufferData(GL_ARRAY_BUFFER, sizeof typeof t.color_data, to_byte_array(t.color_data).data, GL_STATIC_DRAW)
    }

    // Create VAO
    #if #defined(js){
    vao := glCreateVertexArray()
    } else {
    vao: GLuint
    glGenVertexArrays(1, &vao)
    }
    glBindVertexArray(vao)

    // Map pointers
    glEnableVertexAttribArray(0)
    glBindBuffer(GL_ARRAY_BUFFER, vertex_buf)
    glVertexAttribPointer(0, 2, GL_FLOAT, false, sizeof Vec2, 0)

    glEnableVertexAttribArray(1)
    glBindBuffer(GL_ARRAY_BUFFER, color_buf)
    glVertexAttribPointer(1, 4, GL_FLOAT, false, sizeof Color, 0)

    glBindVertexArray(-1)

    t.vao = vao


    return t
}

Triangle.draw :: (triangle: #Self, ctx: &Context) {
    glBindVertexArray(triangle.vao)
    glDrawArrays(GL_TRIANGLES, 0, 3)
}

// ---- Shapes - Triangle ----

// ---- Color ----
ColorValue :: enum {
    Black
    White
    Yellow
    Green
    // TODO: MOREEEEEEE
}
// ---- Color ----

// --- Helpers ---
LogLevel :: enum {Debug; Info; Error;}
log :: (level: LogLevel, text: str) {
    lvl_txt: str
    switch level {
        case .Debug {
            lvl_txt = "DEBUG"
        }
        case .Info {
            lvl_txt = "INFO "
        }
        case .Error {
            lvl_txt = "ERROR"
        }
    }
    #if #defined(js) {
        js.Global->get("console")->call("log", "[", lvl_txt, "] ", text)
    } else {
        printf("[{}] {}\n", lvl_txt, text)
    }
}

to_byte_array :: macro (x: [] $T) -> [] u8 {
    return .{ ~~ x.data, (sizeof T) * x.count };
}
// --- Helpers ---
